      "strictRejects": true,
      "narrowRejects": false
    },
    {
      "name": "claude-opus pricing",
      "message": "feat(prices): add claude-opus pricing",
      "strictRejects": true,
      "narrowRejects": false
    },
    {
      "name": "Claudia (a person)",
      "message": "docs: thanks to Claudia for the review",
      "strictRejects": false,
      "narrowRejects": false
    },
    {
      "name": "Codex in prose",
      "message": "fix: the bot Codex flagged this",
      "strictRejects": true,
      "narrowRejects": false
    },
    {
      "name": "review phrasing",
      "message": "Review: Claude + Codex bounded review",
      "strictRejects": true,
      "narrowRejects": true
    },
    {
      "name": "two independent reviews",
      "message": "Review: two independent reviews, no findings",
