{
  "description": "Patterns that reject a commit message, PR title or PR body naming an AI tool as its author or its reviewer. The organisation rulesets copy these two strings; a test keeps the copies equal. RE2 syntax, no lookaround.",
  "strict": "(?im)(^[ \\t>]*(co-authored-by|signed-off-by|authored-by)[ \\t]*:[^\\n]*\\b(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine)\\b|noreply@(anthropic|openai|claude)\\.|\\bgenerated (with|by) (\\[|an? )?(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine|ai)\\b|(^|[^@\\w])(codex|anthropic|chatgpt)\\b|\\bclaude([^.]|$))",
  "narrow": "(?im)(^[ \\t>]*(co-authored-by|signed-off-by|authored-by)[ \\t]*:[^\\n]*\\b(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine)\\b|noreply@(anthropic|openai|claude)\\.|\\bgenerated (with|by) (\\[|an? )?(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine|ai)\\b|\\b(claude|codex)\\s*(\\+|and|&|/|,)\\s*(claude|codex)\\b|\\b(claude|codex)\\b[^\\n]{0,20}\\b(reviews?|pass|reviewer|bot|findings?)\\b)",
  "narrowRepos": [
    "bymax-agent-kit",
    "nest-ai-tokens",
    "nest-ai-tokens-example"
  ],
  "cases": [
    {
      "name": "real trailer (claude)",
      "message": "feat: x\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
      "strictRejects": true,
      "narrowRejects": true
    },
    {
      "name": "real trailer (codex)",
      "message": "fix: y\n\nCo-authored-by: Codex <x@openai.com>",
      "strictRejects": true,
      "narrowRejects": true
    },
    {
      "name": "dependabot trailer",
