{
  "description": "Patterns that reject a commit message, PR title or PR body naming an AI tool as its author or its reviewer. The organisation rulesets copy these two strings; a test keeps the copies equal. RE2 syntax, no lookaround.",
  "strict": "(?im)(^[ \\t]*co-authored-by:[^\\n]*(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine)|noreply@(anthropic|openai)\\.com|\\bgenerated (with|by) (\\[|an? )?(claude|codex|ai|chatgpt|copilot)|\\b(codex|anthropic|openai|chatgpt)\\b|\\bclaude([^.]|$))",
  "narrow": "(?im)(^[ \\t]*co-authored-by:[^\\n]*(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine)|noreply@(anthropic|openai)\\.com|\\bgenerated (with|by) (\\[|an? )?(claude|codex|ai|chatgpt|copilot)|\\b(claude|codex)\\s*(\\+|and|&|/|,)\\s*(claude|codex)\\b|\\b(claude|codex)\\b[^\\n]{0,20}\\b(reviews?|pass|reviewer|bot|findings?)\\b)",
  "narrowRepos": [
    "bymax-agent-kit",
    "nest-ai-tokens",
    "nest-ai-tokens-example"
  ],
  "cases": [
    {
      "name": "real trailer (claude)",
      "message": "feat: x\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
      "strictRejects": true,
      "narrowRejects": true
    },
    {
      "name": "real trailer (codex)",
      "message": "fix: y\n\nCo-authored-by: Codex <x@openai.com>",
      "strictRejects": true,
      "narrowRejects": true
    },
    {
      "name": "dependabot trailer",
      "message": "chore(deps): bump a from 1 to 2 (#3)\n\nCo-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>",
      "strictRejects": false,
      "narrowRejects": false
    },
    {
      "name": "human co-author",
      "message": "feat: z\n\nCo-authored-by: Maria Silva <maria@example.com>",
      "strictRejects": false,
      "narrowRejects": false
    },
    {
      "name": "CLAUDE.md file",
      "message": "docs: update CLAUDE.md with the new rule",
      "strictRejects": false,
      "narrowRejects": false
    },
    {
      "name": "scope docs(claude)",
