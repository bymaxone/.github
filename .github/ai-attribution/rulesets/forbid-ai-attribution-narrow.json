{
  "name": "forbid-ai-attribution-narrow",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    },
    "repository_name": {
      "include": [
        "bymax-agent-kit",
        "nest-ai-tokens",
        "nest-ai-tokens-example"
      ],
      "exclude": [],
      "protected": false
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "no AI attribution in a commit message",
        "negate": true,
        "operator": "regex",
        "pattern": "(?im)(^[ \\t]*co-authored-by:[^\\n]*(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider|windsurf|codeium|tabnine)|noreply@(anthropic|openai)\\.com|\\bgenerated (with|by) (\\[|an? )?(claude|codex|ai|chatgpt|copilot)|\\b(claude|codex)\\s*(\\+|and|&|/|,)\\s*(claude|codex)\\b|\\b(claude|codex)\\b[^\\n]{0,20}\\b(reviews?|pass|reviewer|bot|findings?)\\b)"
      }
    }
  ]
}
