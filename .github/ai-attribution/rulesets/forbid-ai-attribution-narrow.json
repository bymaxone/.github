{
  "name": "forbid-ai-attribution-narrow",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    },
    "repository_name": {
      "include": [
        "bymax-agent-kit",
        "nest-ai-tokens",
        "nest-ai-tokens-example"
      ],
      "exclude": [],
      "protected": false
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "no AI attribution in a commit message",
        "negate": true,
        "operator": "regex",
        "pattern": "(?im)(^[ \\t>]*[a-z][a-z-]*-by[ \\t]*:[^\\n]*\\b(claude|anthropic|codex|openai|chatgpt|gpt|copilot|gemini|cursor|windsurf|devin|aider|codeium|tabnine|bard|grok|deepseek|mistral|kiro|perplexity)\\b|noreply@(anthropic|openai|claude)\\.|\\b(claude|anthropic|codex|openai|chatgpt|gpt|copilot|gemini|cursor|windsurf|devin|aider|codeium|tabnine|bard|grok|deepseek|mistral|kiro|perplexity)\\[bot\\]|🤖[^\\n]*\\b(claude|anthropic|codex|openai|chatgpt|gpt|copilot|gemini|cursor|windsurf|devin|aider|codeium|tabnine|bard|grok|deepseek|mistral|kiro|perplexity)\\b|^[ \\t>*_-]*[\\[(]?(ai[- ](generated|assisted|authored|written)|(generated|assisted|authored|written|created|made)\\s+(with|by)\\s+ai)[\\])]?[ \\t.]*$|\\bwith\\s+(the\\s+)?help\\s+(of|from)\\s+(claude|anthropic|codex|openai|chatgpt|gpt|copilot|gemini|cursor|windsurf|devin|aider|codeium|tabnine|bard|grok|deepseek|mistral|kiro|perplexity)\\b|\\b(thanks\\s+to|courtesy\\s+of)\\s+(claude|anthropic|codex|openai|chatgpt|gpt|copilot|gemini|cursor|windsurf|devin|aider|codeium|tabnine|bard|grok|deepseek|mistral|kiro|perplexity)\\b|\\b(generated|authored|co-authored|reviewed|assisted|approved|audited|verified|drafted|checked|proposed|suggested)\\s+(with|by|using)\\s+(the\\s+|an?\\s+|\\[)?(claude|anthropic|codex|openai|chatgpt|gpt|copilot|gemini|cursor|windsurf|devin|aider|codeium|tabnine|bard|grok|deepseek|mistral|kiro|perplexity)\\b|\\b(claude|codex)\\s*(\\+|and|&|/|,)\\s*(claude|codex)\\b|\\b(claude|codex)\\b[^\\n]{0,20}\\b(review|reviews|pass|reviewer|bot|finding|findings)\\b)"
      }
    }
  ]
}
